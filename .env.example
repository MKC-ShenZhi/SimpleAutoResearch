# Optional named catalog: profiles/routes in TOML, secrets only in this file.
# With a catalog, its complete connection replaces the legacy settings below.
SIMPLE_AR_MODELS_CONFIG=
RESEARCH_API_KEY=
CCTQ_API_KEY=

# Optional literature-provider credentials, separate from model/image keys.
# Blank means anonymous access subject to each provider's quota.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Optional web discovery; enable with research_sources=[..., "web"].
TAVILY_API_KEY=

# Legacy single-connection setup remains supported when no catalog is selected.
# Native start requires SIMPLE_AR_LLM_API=chat and supports Chat streaming.
# This template opts into native-compatible Chat streaming; the code's
# environment-only legacy default (when omitted) remains Responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SIMPLE_AR_MODEL=gpt-4o-mini
SIMPLE_AR_LLM_BACKEND=openai
SIMPLE_AR_LLM_API=chat
SIMPLE_AR_LLM_STREAM=true
SIMPLE_AR_CHAT_TOKEN_LIMIT_PARAM=auto
SIMPLE_AR_LLM_REASONING_EFFORT=
SIMPLE_AR_LLM_REASONING_OUTPUT_TOKENS=
# Leave empty, 0, off, none, or unlimited to omit provider-side limits.
SIMPLE_AR_LLM_TIMEOUT_SEC=
SIMPLE_AR_MAX_OUTPUT_TOKENS=
SIMPLE_AR_LLM_RETRY_ATTEMPTS=3
SIMPLE_AR_LLM_RETRY_BASE_DELAY_SEC=1
SIMPLE_AR_LLM_RETRY_MAX_DELAY_SEC=12
# Structured calls request native JSON when supported; explicit rejection falls back.
SIMPLE_AR_JSON_RESPONSE_FORMAT=auto
SIMPLE_AR_INPUT_PRICE_PER_1M=
SIMPLE_AR_OUTPUT_PRICE_PER_1M=
